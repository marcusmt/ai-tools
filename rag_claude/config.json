{
  "ollama": {
    "url": "http://localhost:11434",
    "embedding_model": "nomic-embed-text",
    "rag_model": "mistral",
    "agent_model": "qwen3-coder",
    "temperature": 0.7,
    "timeout": 120
  },
  "indexing": {
    "chunk_size": 4000,
    "overlap": 200,
    "patterns": [
      "*.java",
      "*.xml",
      "*.properties",
      "*.md",
      "*.yaml",
      "*.yml"
    ],
    "exclude_dirs": [
      "target/",
      "node_modules/",
      ".git/",
      "rag_db/",
      ".rar_index/",
      "build/",
      "dist/"
    ]
  },
  "retrieval": {
    "top_k": 15,
    "min_similarity": 0.5,
    "include_distances": true
  },
  "generation": {
    "max_tokens": 1024,
    "context_window_size": 4000,
    "system_prompt": "You are an expert Java developer. Answer questions about the codebase based on the retrieved code context. Be concise and specific."
  },
  "chunking_strategy": {
    "extract_classes": true,
    "extract_methods": true,
    "extract_imports": true,
    "extract_annotations": true,
    "extract_javadoc": true,
    "max_chunk_chars": 4000
  },
  "search": {
    "use_hybrid_search": true,
    "keyword_weight": 0.5,
    "vector_weight": 0.5,
    "rerank_results": true
  },
  "debug": {
    "verbose": false,
    "log_chunks": false,
    "log_embeddings": false
  },
  "agent": {
    "timeout": 120,
    "max_tokens_default": 12000,
    "max_tokens_analysis": 12000,
    "max_tokens_recommendation": 12000,
    "num_queries": 3,
    "context_snippet_length": 12000,
    "problem_words_to_extract": 3
  }
}
